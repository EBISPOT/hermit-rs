SubClassOf(<file:/c/test.owl#A> DataSomeValuesFrom(<file:/c/test.owl#dp> DatatypeRestriction(<http://www.w3.org/2001/XMLSchema#integer> <http://www.w3.org/2001/XMLSchema#minInclusive> "6"^^<http://www.w3.org/2001/XMLSchema#integer> <http://www.w3.org/2001/XMLSchema#maxInclusive> "9"^^<http://www.w3.org/2001/XMLSchema#integer>)))
