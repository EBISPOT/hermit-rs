Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#A> <file:/c/test.owl#a>)
ClassAssertion(<file:/c/test.owl#C> <file:/c/test.owl#a>)
SubClassOf(<file:/c/test.owl#A> ObjectSomeValuesFrom(ObjectInverseOf(<file:/c/test.owl#r>) <file:/c/test.owl#B>))
SubClassOf(<file:/c/test.owl#B> ObjectSomeValuesFrom(<file:/c/test.owl#r> <file:/c/test.owl#D>))
SubClassOf(<file:/c/test.owl#D> <file:/c/test.owl#C>)
SubClassOf(<http://www.w3.org/2002/07/owl#Thing> ObjectMaxCardinality(1 <file:/c/test.owl#r> <file:/c/test.owl#C>))
)
