AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#Siciliana> "Siciliana"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#SlicedTomatoTopping> "CoberturaDeTomateFatiado"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#SloppyGiuseppe> "SloppyGiuseppe"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#Soho> "Soho"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#Spiciness> "Tempero"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#SpicyPizza> "PizzaTemperada"@pt)
AnnotationAssertion(<http://www.w3.org/2000/01/rdf-schema#label> <http://www.co-ode.org/ontologies/pizza/2005/05/16/pizza.owl#SpicyPizzaEquivalent> "PizzaTemperadaEquivalente"@pt)
