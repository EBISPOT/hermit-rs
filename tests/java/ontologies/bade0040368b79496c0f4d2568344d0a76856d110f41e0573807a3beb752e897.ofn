SubClassOf(<file:/c/test.owl#A> ObjectSomeValuesFrom(<file:/c/test.owl#S> ObjectOneOf(<file:/c/test.owl#n>)))
SubClassOf(<file:/c/test.owl#B> ObjectSomeValuesFrom(<file:/c/test.owl#R> <file:/c/test.owl#B>))
