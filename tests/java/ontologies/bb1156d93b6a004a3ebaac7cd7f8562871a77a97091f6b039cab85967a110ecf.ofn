Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#A> <file:/c/test.owl#a>)
ClassAssertion(<file:/c/test.owl#RD0> <file:/c/test.owl#rd0>)
ClassAssertion(<http://www.w3.org/2002/07/owl#Thing> <file:/c/test.owl#a>)
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#A> Variable(<file:/c/test.owl#X>)) ClassAtom(<file:/c/test.owl#RD0> Variable(<file:/c/test.owl#Z>)))Head(ClassAtom(<file:/c/test.owl#D0> Variable(<file:/c/test.owl#Z>))))
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#A> Variable(<file:/c/test.owl#X>)) ClassAtom(<file:/c/test.owl#RD0> Variable(<file:/c/test.owl#Z>)))Head(ObjectPropertyAtom(<file:/c/test.owl#R> Variable(<file:/c/test.owl#X>) Variable(<file:/c/test.owl#Z>))))
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#D0> Variable(<file:/c/test.owl#X>)))Head(ClassAtom(<file:/c/test.owl#A> Variable(<file:/c/test.owl#X>))))
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#D0> Variable(<file:/c/test.owl#X>)))Head(ClassAtom(<file:/c/test.owl#B> Variable(<file:/c/test.owl#X>))))
)
