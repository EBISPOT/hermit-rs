Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<http://www.w3.org/2002/07/owl#Thing> <file:/c/test.owl#a>)
ClassAssertion(ObjectAllValuesFrom(<file:/c/test.owl#r> <http://www.w3.org/2002/07/owl#Nothing>) <file:/c/test.owl#a>)
ReflexiveObjectProperty(<file:/c/test.owl#r>)
)
