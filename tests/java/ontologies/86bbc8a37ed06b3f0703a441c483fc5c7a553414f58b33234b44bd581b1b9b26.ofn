Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#A> <file:/c/test.owl#a>)
ClassAssertion(<file:/c/test.owl#D> <file:/c/test.owl#b>)
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#B> Variable(<file:/c/test.owl#x>)))Head(ClassAtom(<file:/c/test.owl#C> Variable(<file:/c/test.owl#x>))))
SubClassOf(<file:/c/test.owl#A> <file:/c/test.owl#B>)
)
