ClassAssertion(<file:/c/test.owl#B> <file:/c/test.owl#b>)
ClassAssertion(<file:/c/test.owl#C> <file:/c/test.owl#c>)
ClassAssertion(<file:/c/test.owl#D> <file:/c/test.owl#d>)
ClassAssertion(<file:/c/test.owl#E> <file:/c/test.owl#e>)
DLSafeRule(Body(ClassAtom(<file:/c/test.owl#B> <file:/c/test.owl#b>) ObjectPropertyAtom(<file:/c/test.owl#rab> Variable(<file:/c/test.owl#xa>) Variable(<file:/c/test.owl#xb>)) ObjectPropertyAtom(<file:/c/test.owl#rac> Variable(<file:/c/test.owl#xa>) Variable(<file:/c/test.owl#xc>)) ObjectPropertyAtom(<file:/c/test.owl#rcd> Variable(<file:/c/test.owl#xc>) Variable(<file:/c/test.owl#xd>)) ClassAtom(<file:/c/test.owl#A> Variable(<file:/c/test.owl#xa>)) ClassAtom(<file:/c/test.owl#E> Variable(<file:/c/test.owl#xe>)))Head(ClassAtom(<file:/c/test.owl#Dp> Variable(<file:/c/test.owl#xd>)) ClassAtom(<file:/c/test.owl#Cp> <file:/c/test.owl#c>) ObjectPropertyAtom(<file:/c/test.owl#rae> Variable(<file:/c/test.owl#xa>) Variable(<file:/c/test.owl#xe>)) ClassAtom(<file:/c/test.owl#Ep> Variable(<file:/c/test.owl#xe>)) ClassAtom(<file:/c/test.owl#Bp> Variable(<file:/c/test.owl#xb>)) ClassAtom(<file:/c/test.owl#Ap> Variable(<file:/c/test.owl#xa>))))
ObjectPropertyAssertion(<file:/c/test.owl#rab> <file:/c/test.owl#a> <file:/c/test.owl#b>)
ObjectPropertyAssertion(<file:/c/test.owl#rac> <file:/c/test.owl#a> <file:/c/test.owl#c>)
ObjectPropertyAssertion(<file:/c/test.owl#rcd> <file:/c/test.owl#c> <file:/c/test.owl#d>)
)
