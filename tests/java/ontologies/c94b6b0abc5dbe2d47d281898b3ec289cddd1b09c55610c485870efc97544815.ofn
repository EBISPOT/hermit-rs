Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#Person> <file:/c/test.owl#Peter>)
ClassAssertion(<file:/c/test.owl#Person> <file:/c/test.owl#Peter_Griffin>)
DataPropertyAssertion(<file:/c/test.owl#hasSSN> <file:/c/test.owl#Peter> "123-45-6789")
DataPropertyAssertion(<file:/c/test.owl#hasSSN> <file:/c/test.owl#Peter_Griffin> "123-45-6789")
DifferentIndividuals(<file:/c/test.owl#Peter> <file:/c/test.owl#Peter_Griffin>)
HasKey(<file:/c/test.owl#Person> () (<file:/c/test.owl#hasSSN>))
)
