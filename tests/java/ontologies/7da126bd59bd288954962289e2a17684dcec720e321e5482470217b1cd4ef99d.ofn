Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#A> <file:/c/test.owl#a>)
NegativeDataPropertyAssertion(<file:/c/test.owl#dp> <file:/c/test.owl#a> "5"^^<http://www.w3.org/2001/XMLSchema#integer>)
SubClassOf(<file:/c/test.owl#A> DataSomeValuesFrom(<file:/c/test.owl#dp> DataOneOf("5"^^<http://www.w3.org/2001/XMLSchema#integer>)))
)
