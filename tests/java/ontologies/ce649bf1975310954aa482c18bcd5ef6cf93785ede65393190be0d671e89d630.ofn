Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#Car> <file:/c/test.owl#myCar1>)
ClassAssertion(<file:/c/test.owl#Car> <file:/c/test.owl#myCar2>)
ClassAssertion(<file:/c/test.owl#Car> <file:/c/test.owl#myCar3>)
DataPropertyAssertion(<file:/c/test.owl#licensePlate> <file:/c/test.owl#myCar1> "OD-SG-101")
DataPropertyAssertion(<file:/c/test.owl#licensePlate> <file:/c/test.owl#myCar2> "OD-SG-101")
DataPropertyAssertion(<file:/c/test.owl#licensePlate> <file:/c/test.owl#myCar3> "OD-SG-101")
DataPropertyAssertion(<file:/c/test.owl#nationality> <file:/c/test.owl#myCar1> "German")
DataPropertyAssertion(<file:/c/test.owl#nationality> <file:/c/test.owl#myCar2> "German")
DataPropertyAssertion(<file:/c/test.owl#nationality> <file:/c/test.owl#myCar3> "British")
DifferentIndividuals(<file:/c/test.owl#myCar1> <file:/c/test.owl#myCar3>)
DifferentIndividuals(<file:/c/test.owl#myCar2> <file:/c/test.owl#myCar3>)
HasKey(<file:/c/test.owl#Car> () (<file:/c/test.owl#licensePlate> <file:/c/test.owl#nationality>))
)
