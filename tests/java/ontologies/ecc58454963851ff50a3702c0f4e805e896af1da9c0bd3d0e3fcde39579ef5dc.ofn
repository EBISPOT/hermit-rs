Ontology(
ClassAssertion(<file:/c/test.owl#a> <file:/c/test.owl#i1>)
ClassAssertion(<file:/c/test.owl#c> <file:/c/test.owl#i2>)
ClassAssertion(<file:/c/test.owl#e> <file:/c/test.owl#i4>)
EquivalentClasses(<file:/c/test.owl#a> ObjectSomeValuesFrom(<file:/c/test.owl#r> <file:/c/test.owl#b>))
EquivalentClasses(<file:/c/test.owl#c> ObjectSomeValuesFrom(<file:/c/test.owl#r> <file:/c/test.owl#d>))
ObjectPropertyAssertion(<file:/c/test.owl#r> <file:/c/test.owl#i3> <file:/c/test.owl#i4>)
SubClassOf(<file:/c/test.owl#b> <file:/c/test.owl#e>)
SubClassOf(<file:/c/test.owl#d> <file:/c/test.owl#e>)
)
