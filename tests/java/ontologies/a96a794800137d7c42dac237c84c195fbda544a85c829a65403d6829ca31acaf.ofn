Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
NegativeObjectPropertyAssertion(<file:/c/test.owl#hasAunt> <file:/c/test.owl#Stewie> <file:/c/test.owl#Carol>)
ObjectPropertyAssertion(<file:/c/test.owl#hasMother> <file:/c/test.owl#Stewie> <file:/c/test.owl#Lois>)
ObjectPropertyAssertion(<file:/c/test.owl#hasSister> <file:/c/test.owl#Lois> <file:/c/test.owl#Carol>)
SubObjectPropertyOf(ObjectPropertyChain(<file:/c/test.owl#hasMother> <file:/c/test.owl#hasSister>) <file:/c/test.owl#hasAunt>)
)
