Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(
ClassAssertion(<file:/c/test.owl#A> <file:/c/test.owl#a>)
ClassAssertion(<file:/c/test.owl#B> <file:/c/test.owl#b>)
DLSafeRule(Body(ObjectPropertyAtom(<file:/c/test.owl#r> Variable(<file:/c/test.owl#x>) Variable(<file:/c/test.owl#y>)) DifferentIndividualsAtom(Variable(<file:/c/test.owl#x>) Variable(<file:/c/test.owl#y>)))Head(ClassAtom(<file:/c/test.owl#C> Variable(<file:/c/test.owl#x>))))
DisjointClasses(<file:/c/test.owl#A> <file:/c/test.owl#B>)
ObjectPropertyAssertion(<file:/c/test.owl#r> <file:/c/test.owl#a> <file:/c/test.owl#b>)
)
